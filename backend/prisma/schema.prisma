// This is your Prisma Schema Configuration
// Save this file as: backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Ensure this matches your DB provider (postgresql, mysql, etc.)
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum UserRole {
  ADMIN
  OWNER
  ACCOUNTANT
  STAFF
}

enum BusinessType {
  SOLE_PROPRIETOR
  PARTNERSHIP
  PVT_LTD
}

// --- Models ---

model Business {
  id String @id @default(uuid())

  // Core Business Info
  name String
  pan  String       @unique
  type BusinessType

  // Contact Info
  ownerName String
  phone     String
  email     String

  // Address Fields
  address      String // Formatted full address
  addressLine1 String
  addressLine2 String?
  city         String
  province     String
  country      String
  zipCode      String

  // Tax Logic Fields (New)
  taxSystem      String? @default("PAN") // 'PAN' or 'VAT'
  annualTurnover Float?  @default(0)

  // Verification & Media
  // Manual verification required (Default: false)
  isVerified Boolean @default(false)
  rejectionReason String? // Optional field to store rejection reason
  panPhoto   String? @db.Text // Large text for Base64 image
  logo       String? @db.Text // Large text for Base64 logo
  
  // App Settings
  enableBiometricLogin Boolean? @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users        User[]
  transactions Transaction[]
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  phone    String   @unique
  password String
  role     UserRole
  status   String?  @default("Active")

  // Relations
  businessId String? // Nullable (e.g., for Super Admin)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id String @id @default(uuid())

  // Relationships
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Core Data
  date     DateTime
  type     String // "SALES" or "EXPENSE"
  category String // e.g. "Rent", "Sales Revenue"
  amount   Float // Using Float to match JS number type

  // Tax & Party Info
  vatAmount  Float?
  partyName  String? // Customer or Vendor Name
  partyPan   String?
  billNumber String?

  // Media & Compliance
  imageUrl          String?  @db.Text
  isComplianceIssue Boolean? @default(false)
  complianceMessage String?

  // JSON Field for Invoice Line Items (Items, Qty, Rate, etc.)
  invoiceDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}